ARK_API_KEY=your_byteplus_modelark_api_key
ARK_MODEL_ID=dola-seedream-5-0-pro-260628
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# 是否在生图完成后自动保存图片
AUTO_SAVE_IMAGES=true
# 是否为每张已保存图片生成同名 .txt 提示词参数记录；仅可在 AUTO_SAVE_IMAGES=true 时开启
SAVE_PROMPT_METADATA=false
OUTPUT_DIR=generated
# 设为 0.0.0.0 可允许局域网设备访问
HOST=127.0.0.1
PORT=8787
# debug | info | warn | error | silent
LOG_LEVEL=info
STATUS_LOG_INTERVAL_MS=10000
